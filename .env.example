# Copy to .env and fill in. Never commit .env.

# --- Canton (Daml ledger for session logs) ---
# CANTON_ENABLE=true
# CANTON_JSON_API_BASE_URL=http://localhost:7575
# CANTON_LEDGER_ID=sandbox
# CANTON_PATIENT_PARTY=sandbox::1220...
# CANTON_PHYSIO_PARTY=sandbox::1220...
# CANTON_JWT=<from: node canton/jwt-dev.js>
# CANTON_SESSIONLOG_TEMPLATE_ID=<optional; set if you rebuild the DAR>

# --- Optional: Anyway (LLM observability) ---
# ANYWAY_API_KEY=your-anyway-api-key

# --- Optional: Stripe (payments) ---
# STRIPE_SECRET_KEY=sk_test_... or sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # if using webhooks

# --- Agent (used by score.js) ---
# AGENT_LABEL=krumpbot-fit
